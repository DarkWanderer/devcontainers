FROM fedora:45@sha256:aacbc26b38361ba0cb3d10f268da40b61b36aed6ed6fe5831a35871636bedb06
LABEL maintainer="Oleg V. Kozlyuk <elquentaro@gmail.com>"

# Install dependencies
RUN dnf install -y \
    ca-certificates \
    catatonit tini \
    cargo rust just sccache \
    cmake make clang gcc lld mold \
    nodejs npm \
    protobuf-compiler \
    dotnet-sdk-9.0 dotnet-sdk-10.0 \
    gh jq git pkg-config \
    openssl-devel \
    shadow-utils \
    sudo curl wget which \
    podman fuse-overlayfs crun podman-docker \
    && dnf clean all

# Nested containers: this runner has no dockerd (libkrunfw's guest kernel lacks the
# overlay/bridge/netfilter modules dockerd needs). Podman configured for host networking
# and fuse-overlayfs storage instead; podman-docker shims `docker` -> `podman` for jobs
# that call the docker CLI.
COPY containers.conf /etc/containers/containers.conf
COPY storage.conf /etc/containers/storage.conf
COPY nodocker /etc/containers/nodocker

# Create a user to run the runner
RUN useradd -m -s /bin/bash -d /runner runner && \
    usermod -aG wheel runner && \
    echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

WORKDIR /runner

# Fetch the latest runner version and download it
RUN RUNNER_VERSION=$(curl -s https://api.github.com/repos/actions/runner/releases/latest | jq -r '.tag_name' | sed 's/v//') && \
    RUNNER_ARCH=$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/') && \
    curl -o actions-runner-linux.tar.gz -L \
    "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-${RUNNER_ARCH}-${RUNNER_VERSION}.tar.gz" && \
    tar xzf actions-runner-linux.tar.gz && \
    rm actions-runner-linux.tar.gz && \
    chown -R runner:runner /runner

USER runner
COPY entrypoint.sh .
ENTRYPOINT ["/runner/entrypoint.sh"]
