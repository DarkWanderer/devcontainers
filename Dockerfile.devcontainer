FROM fedora:45@sha256:aacbc26b38361ba0cb3d10f268da40b61b36aed6ed6fe5831a35871636bedb06
LABEL maintainer="Oleg V. Kozlyuk <elquentaro@gmail.com>"
LABEL repository="https://github.com/DarkWanderer/devcontainers"

ENV CARGO_HOME=/usr/local RUSTUP_HOME=/usr/local CARGO_TARGET_DIR=/target
COPY --chmod=644 config.toml /usr/local/config.toml

VOLUME /target

# USERNAME selects a local account and never carries credential data.
# hadolint ignore=DL3064
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

RUN useradd --uid ${USER_UID} -m ${USERNAME} \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

RUN dnf update -y && \
    dnf install -y --setopt=install_weak_deps=False \
    ca-certificates \
    chezmoi \
    clang \
    cmake \
    curl \
    dotnet-sdk-10.0 \
    gcc \
    gh \
    git \
    jq \
    just \
    lld \
    lldb \
    make \
    mold \
    nodejs \
    npm \
    openssl-devel \
    pkg-config \
    procps-ng \
    protobuf-compiler \
    rustup \
    sccache \
    shadow-utils \
    sudo \
    tini \
    wget \
    which \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Nightly alongside stable so nightly-only tooling (cargo-fuzz, -Z flags, unstable
# rustfmt options) has a toolchain to run under; stable stays the default.
RUN rustup-init -y --no-modify-path --default-toolchain stable \
    && rustup component add rust-src llvm-tools-preview rust-analyzer clippy rustfmt \
    && rustup toolchain install nightly --profile minimal \
    && rustup component add --toolchain nightly rust-src llvm-tools-preview clippy rustfmt

# cargo-outdated pulls in openssl-sys via git2; linking it against the
# system OpenSSL breaks on Fedora releases whose default OpenSSL is newer
# than openssl-sys's supported set (e.g. OpenSSL 4.0 on Fedora 45+), so it
# gets its own install with vendored-openssl rather than joining the others.
RUN cargo install --locked cargo-audit cargo-bump cargo-edit cargo-llvm-cov cargo-sort clippy-sarif sarif-fmt \
    && cargo install --locked --features vendored-openssl cargo-outdated \
    && rm -rf /usr/local/registry \
    && mkdir -p /usr/local/registry \
    && chmod 777 /usr/local/registry \
    && chmod 777 /target

WORKDIR /workspace

ENTRYPOINT [ "/usr/sbin/tini", "--" ]

SHELL ["/bin/bash", "-c"]

CMD ["bash"]
